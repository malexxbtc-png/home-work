menu "Weather station"

    config WS_WIFI_ENABLE
        bool "Enable WiFi (NTP time + forecast)"
        default y

    config WS_WIFI_SSID
        string "WiFi SSID"
        default "YOUR_WIFI_SSID"
        depends on WS_WIFI_ENABLE

    config WS_WIFI_PASSWORD
        string "WiFi password"
        default ""
        depends on WS_WIFI_ENABLE

    config WS_TIMEZONE
        string "POSIX timezone"
        default "EET-2EEST,M3.5.0/3,M10.5.0/4"

    config WS_I2C_SDA
        int "I2C SDA GPIO (OLED, BMP/BME280, DS1307)"
        default 21

    config WS_I2C_SCL
        int "I2C SCL GPIO"
        default 22

    config WS_RTC_ADDR
        hex "DS1307 I2C address"
        default 0x68

    config WS_RTC_SET_FROM_BUILD
        bool "If the RTC is not set and there is no WiFi/GPS, use the build time"
        default y

    config WS_OLED_ADDR
        hex "SSD1306 I2C address"
        default 0x3C

    config WS_SENSOR_ADDR
        hex "BMP280/BME280 I2C address"
        default 0x76

    config WS_UART_TX
        int "UART2 TX GPIO (to ESP32-S3 RX)"
        default 17

    config WS_UART_RX
        int "UART2 RX GPIO (reserved)"
        default 16

    config WS_UART_BAUD
        int "UART2 baud rate"
        default 115200

    config WS_UART_EXTRA
        bool "Also send $GEO and $FCST lines (location + forecast) to the ESP32-S3"
        default n

    config WS_SHORT_SCREEN_MS
        int "Duration of a short screen (ms); the clock screen is 4x longer"
        default 3000

    config WS_GPS_RX
        int "GPS: ESP32 RX GPIO (connect to GP-01 TX)"
        default 25

    config WS_GPS_TX
        int "GPS: ESP32 TX GPIO (connect to GP-01 RX)"
        default 26

    config WS_GPS_EN
        int "GPS power-enable GPIO via MOSFET (-1 = always powered)"
        default -1

    config WS_PIR_GPIO
        int "PIR (AM312) output GPIO, must be an RTC GPIO for wakeup"
        default 33

    config WS_INACTIVITY_S
        int "Seconds without motion before deep sleep"
        default 300

    config WS_FORECAST_REFRESH_MIN
        int "Forecast refresh interval (minutes)"
        default 30

endmenu
