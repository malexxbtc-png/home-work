menu "Weather camera (OV7670)"

config WEATHER_CAMERA_ENABLED
    bool "Enable the camera"
    default y

config WEATHER_CAMERA_INIT_AT_BOOT
    bool "Initialise the camera at boot (otherwise on the first snapshot request)"
    default y
    depends on WEATHER_CAMERA_ENABLED

menu "Pins"
    depends on WEATHER_CAMERA_ENABLED

config WEATHER_CAM_PIN_PWDN
    int "PWDN GPIO (-1 = not connected, tie the module pin to GND)"
    range -1 48
    default -1
config WEATHER_CAM_PIN_RESET
    int "RESET GPIO (-1 = not connected, tie the module pin RET to 3V3)"
    range -1 48
    default -1
config WEATHER_CAM_PIN_XCLK
    int "XCLK GPIO"
    range 0 48
    default 15
config WEATHER_CAM_PIN_SIOD
    int "SIOD (SCCB SDA) GPIO"
    range 0 48
    default 4
config WEATHER_CAM_PIN_SIOC
    int "SIOC (SCCB SCL) GPIO"
    range 0 48
    default 5
config WEATHER_CAM_PIN_VSYNC
    int "VSYNC GPIO"
    range 0 48
    default 6
config WEATHER_CAM_PIN_HREF
    int "HREF GPIO"
    range 0 48
    default 7
config WEATHER_CAM_PIN_PCLK
    int "PCLK GPIO"
    range 0 48
    default 13
config WEATHER_CAM_PIN_D0
    int "D0 GPIO"
    range 0 48
    default 11
config WEATHER_CAM_PIN_D1
    int "D1 GPIO"
    range 0 48
    default 9
config WEATHER_CAM_PIN_D2
    int "D2 GPIO"
    range 0 48
    default 8
config WEATHER_CAM_PIN_D3
    int "D3 GPIO"
    range 0 48
    default 10
config WEATHER_CAM_PIN_D4
    int "D4 GPIO"
    range 0 48
    default 12
config WEATHER_CAM_PIN_D5
    int "D5 GPIO"
    range 0 48
    default 14
config WEATHER_CAM_PIN_D6
    int "D6 GPIO"
    range 0 48
    default 1
config WEATHER_CAM_PIN_D7
    int "D7 GPIO"
    range 0 48
    default 2
endmenu

config WEATHER_CAM_XCLK_MHZ
    int "XCLK frequency (MHz)"
    range 5 20
    default 10
    depends on WEATHER_CAMERA_ENABLED
    help
        10 MHz is more tolerant of long jumper wires than 20 MHz. If frames come out short
        ("cam_hal: FB-SIZE ... !=" in the log), try 20 MHz with short wires.

choice WEATHER_CAM_FRAME
    prompt "Snapshot resolution"
    default WEATHER_CAM_FRAME_QVGA
    depends on WEATHER_CAMERA_ENABLED
config WEATHER_CAM_FRAME_QVGA
    bool "QVGA 320x240"
config WEATHER_CAM_FRAME_VGA
    bool "VGA 640x480"
endchoice

config WEATHER_CAM_JPEG_QUALITY
    int "JPEG quality (1-100, higher is better)"
    range 10 100
    default 85
    depends on WEATHER_CAMERA_ENABLED

config WEATHER_CAM_WARMUP_FRAMES
    int "Frames to discard before the snapshot (auto exposure settling)"
    range 0 20
    default 8
    depends on WEATHER_CAMERA_ENABLED

config WEATHER_CAM_POWER_DOWN
    bool "Stop the camera clock (XCLK) between snapshots"
    default y
    depends on WEATHER_CAMERA_ENABLED
    help
        XCLK is a fast clock that can couple into long SD-card wires and break SPI reads.
        With this option the camera is started for each snapshot and stopped before writing to the SD.

config WEATHER_CAM_HFLIP
    bool "Mirror horizontally"
    default n
    depends on WEATHER_CAMERA_ENABLED

config WEATHER_CAM_VFLIP
    bool "Flip vertically"
    default n
    depends on WEATHER_CAMERA_ENABLED

config WEATHER_CAM_SWAP_BYTES
    bool "Swap bytes of RGB565 pixels (try this if colours look wrong)"
    default n
    depends on WEATHER_CAMERA_ENABLED

config WEATHER_CAM_MIN_FREE_MB
    int "Delete the oldest photo folders when free SD space is below (MB)"
    range 8 8192
    default 200
    depends on WEATHER_CAMERA_ENABLED

endmenu
