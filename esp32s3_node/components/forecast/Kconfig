menu "Weather data from master"

config WEATHER_FORECAST_STALE_AFTER_SECONDS
    int "Mark weather stale after (seconds)"
    range 60 604800
    default 7200
    help
        Weather is fetched by the master. If its age (reported by the master)
        exceeds this value, the display greys the outside temperature.

config WEATHER_FORECAST_MUTEX_TIMEOUT_MS
    int "Weather cache mutex timeout (ms)"
    range 1 1000
    default 50

endmenu
