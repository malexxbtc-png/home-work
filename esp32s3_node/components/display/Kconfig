menu "Weather display (ST7789P3 76x284)"

config WEATHER_DISPLAY_PIN_SCLK
    int "TFT SCK GPIO"
    range 0 48
    default 39

config WEATHER_DISPLAY_PIN_MOSI
    int "TFT MOSI (SDA) GPIO"
    range 0 48
    default 38
    help
        The on-board RGB LED sits on GPIO48 (older boards) or GPIO38 (v1.1).
        If it blinks with the display, move this pin to the other one.

config WEATHER_DISPLAY_PIN_CS
    int "TFT CS GPIO"
    range 0 48
    default 41

config WEATHER_DISPLAY_PIN_DC
    int "TFT DC GPIO"
    range 0 48
    default 42

config WEATHER_DISPLAY_PIN_RST
    int "TFT RST GPIO"
    range 0 48
    default 47

config WEATHER_DISPLAY_GAP_X
    int "Panel gap X (landscape)"
    range 0 320
    default 18
    help
        Offset of the visible area in controller RAM along the long (284 px)
        axis after swap_xy. If the picture is shifted, swap GAP_X and GAP_Y.

config WEATHER_DISPLAY_GAP_Y
    int "Panel gap Y (landscape)"
    range 0 320
    default 82

config WEATHER_DISPLAY_INVERT_COLORS
    bool "Invert colours"
    default y
    help
        Most IPS ST7789 panels need colour inversion. Disable it if the
        colours look negative.

endmenu