menu "Weather master network"

config WEATHER_NET_WIFI_SSID
    string "Wi-Fi SSID"
    default ""
    help
        Wi-Fi network name. Empty = network disabled (the master works
        with the DS1307 only and has no outdoor weather).

config WEATHER_NET_WIFI_PASSWORD
    string "Wi-Fi password"
    default ""
    help
        Wi-Fi password. Configure locally; never commit sdkconfig.

config WEATHER_NET_LATITUDE
    string "Open-Meteo latitude"
    default "49.9935"

config WEATHER_NET_LONGITUDE
    string "Open-Meteo longitude"
    default "36.2304"

config WEATHER_NET_TIMEZONE
    string "Open-Meteo timezone"
    default "Europe/Kyiv"

config WEATHER_NET_POSIX_TZ
    string "POSIX local timezone"
    default "EET-2EEST,M3.5.0/3,M10.5.0/4"
    help
        Used to turn SNTP (UTC) time into local wall time for the DS1307
        and for the ESP32-S3 node.

config WEATHER_NET_SNTP_SERVER
    string "SNTP server"
    default "pool.ntp.org"

config WEATHER_NET_WIFI_CONNECT_TIMEOUT_MS
    int "Wi-Fi connection wait (ms)"
    range 1000 120000
    default 30000

config WEATHER_NET_RETRY_INTERVAL_MS
    int "Retry interval after a failure (ms)"
    range 1000 600000
    default 30000

config WEATHER_NET_HTTP_TIMEOUT_MS
    int "Open-Meteo HTTP timeout (ms)"
    range 1000 60000
    default 10000

config WEATHER_NET_UPDATE_INTERVAL_MINUTES
    int "Forecast update interval (minutes)"
    range 1 1440
    default 15

config WEATHER_NET_FORECAST_DAYS
    int "Forecast days"
    range 1 7
    default 3

config WEATHER_NET_HTTP_BUFFER_SIZE
    int "HTTP response buffer size (bytes)"
    range 2048 16384
    default 4096

endmenu
